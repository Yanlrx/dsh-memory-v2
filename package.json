{
    "name":  "dsh-memory-v2",
    "version":  "0.1.1",
    "description":  "用户记忆 —— 给 DeepSeek Harness 的长期记忆插件：每轮自动存档、自动召回、按天巩固，有效性/权重/过期三个函数各管一件事。",
    "license":  "MIT",
    "engines": { "node": ">=18" },
    "author":  "伊万莉瑞希",
    "icon":  "icon.svg",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./store":  "./lib/store.js",
                    "./recall":  "./lib/recall.js",
                    "./consolidate":  "./lib/consolidate.js",
                    "./valid":  "./lib/valid.js",
                    "./weight":  "./lib/weight.js",
                    "./expiry":  "./lib/expiry.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "icon.svg",
                  "README.md",
                  "CHANGELOG.md",
                  "LICENSE",
                  "cordis.patch.yml"
              ],
    "keywords":  [
                     "deepseek-harness",
                     "dsh-plugin",
                     "memory"
                 ],
    "scripts":  {
                    "test":  "node test/run-all.js"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            }
}
